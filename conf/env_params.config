/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Cluster Config for the Expanding Parameters to Include Containers and Conda
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    You will have to be exact if you are using this in terms of the names!!
----------------------------------------------------------------------------------------
*/
// Additional env params to use
params {
    // chewBBACA
    chewbbaca_conda_version         = "bioconda::chewBBACA=3.5.3"
    chewbbaca_singularity_container = "https://depot.galaxyproject.org/singularity/chewbbaca:3.5.3--pyh106432d_1"
    chewbbaca_docker_container      = "biocontainers/chewBBACA:3.5.3--pyh106432d_1"

    // El_Gato
    el_gato_conda_version           = "bioconda::el_gato=1.20.2"
    el_gato_singularity_container   = "https://depot.galaxyproject.org/singularity/el_gato:1.20.2--py311h7e72e81_0"
    el_gato_docker_container        = "biocontainers/el_gato:1.20.2--py311h7e72e81_0"
}

validation.defaultIgnoreParams = [
    "chewbbaca_conda_version",
    "chewbbaca_singularity_container",
    "chewbbaca_docker_container",
    "el_gato_conda_version",
    "el_gato_singularity_container",
    "el_gato_docker_container"
]

// Set conda and containers to use the params
//  NOTE: It will always warn the param isn't initialized but it is and it should work
process {
    withName: "CHEWBBACA.*" {
        conda       = "${params.chewbbaca_conda_version}"
        container   = {
            workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container ?
                "${params.chewbbaca_singularity_container}" :
                "${params.chewbbaca_docker_container}"
        }
    }
    withName: "EL_GATO.*" {
        conda       = "${params.el_gato_conda_version}"
        container   = {
            workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container ?
                "${params.el_gato_singularity_container}" :
                "${params.el_gato_docker_container}"
        }
    }
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config for the Expanding Parameters to Include Containers and Conda
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    You will have to be exact if you are using this in terms of the names!!
----------------------------------------------------------------------------------------
*/
// Additional env params to use
params {
    // chewBBACA
    chewbbaca_conda_version         = "bioconda::chewBBACA=3.5.3"
    chewbbaca_singularity_container = "https://depot.galaxyproject.org/singularity/chewbbaca:3.5.3--pyh106432d_1"
    chewbbaca_docker_container      = "biocontainers/chewBBACA:3.5.3--pyh106432d_1"

    // El_Gato
    el_gato_conda_version           = "bioconda::el_gato=1.23.0"
    el_gato_singularity_container   = "https://depot.galaxyproject.org/singularity/el_gato:1.23.0--py311h106432d_0"
    el_gato_docker_container        = "biocontainers/el_gato:1.23.0--py311h106432d_0"
}

// Literally just to prevent warnings on missing params as they get set/evaluated earlier this way
env_param_profile {
    // chewBBACA
    chewbbaca {
        conda_version           = params.chewbbaca_conda_version
        singularity_container   = params.chewbbaca_singularity_container
        docker_container        = params.chewbbaca_docker_container
    }
    // El_Gato
    el_gato {
        conda_version           = params.el_gato_conda_version
        singularity_container   = params.el_gato_singularity_container
        docker_container        = params.el_gato_docker_container
    }
}

validation.defaultIgnoreParams = [
    "chewbbaca_conda_version",
    "chewbbaca_singularity_container",
    "chewbbaca_docker_container",
    "el_gato_conda_version",
    "el_gato_singularity_container",
    "el_gato_docker_container"
]

// Set conda and containers to use the params
process {
    withName: "CHEWBBACA.*" {
        conda       = { env_param_profile.chewbbaca.conda_version }
        container   = {
            workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container ?
                env_param_profile.chewbbaca.singularity_container :
                env_param_profile.chewbbaca.docker_container
        }
    }
    withName: "EL_GATO.*" {
        conda       = { env_param_profile.el_gato.conda_version }
        container   = {
            workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container ?
                env_param_profile.el_gato.singularity_container :
                env_param_profile.el_gato.docker_container
        }
    }
}
